{
  "fn main": {
    "prefix": "fnmain",
    "body": ["fn main(IOStream io) void {", "    $0", "}"],
    "description": "程序入口"
  },
  "fn": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2}) ${3:void} {", "    $0", "}"],
    "description": "函数"
  },
  "type struct": {
    "prefix": "struct",
    "body": ["type struct {", "    ${1:int} ${2:x};", "} ${3:Name};"],
    "description": "结构体"
  },
  "type interface": {
    "prefix": "interface",
    "body": ["type interface {", "    fn ${1:method}(Self self) ${2:int};", "} ${3:Name};"],
    "description": "接口"
  },
  "impl": {
    "prefix": "impl",
    "body": ["impl {", "    fn ${1:method}(${2:Type} self) ${3:int} {", "        $0", "    }", "} ${2:Type};"],
    "description": "实现块"
  },
  "space": {
    "prefix": "space",
    "body": ["space {", "    fn ${1:name}(${2}) ${3:int} {", "        $0", "    }", "} ${4:name};"],
    "description": "空间（自我实现）"
  },
  "library": {
    "prefix": "library",
    "body": ["library ${1:lib} {", "    fn ${2:sym}(${3}) ${4:void};", "}"],
    "description": "FFI 库绑定"
  },
  "for": {
    "prefix": "for",
    "body": ["for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i} = ${1:i} + 1) {", "    $0", "}"],
    "description": "C 风格 for"
  },
  "forin": {
    "prefix": "forin",
    "body": ["for (${1:int} ${2:x} : ${3:list}) {", "    $0", "}"],
    "description": "迭代 for"
  },
  "try": {
    "prefix": "try",
    "body": ["try {", "    $1", "} catch (void ${2:e}) {", "    $0", "}"],
    "description": "try/catch"
  },
  "macro": {
    "prefix": "macro",
    "body": ["#macro ${1:name} (${2:a, b}) {", "    #when (run) {", "        #return ${3:a + b}", "    }", "}"],
    "description": "命名参数宏"
  }
}
