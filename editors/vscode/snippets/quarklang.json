{
  "fn main": {
    "prefix": "fnmain",
    "body": ["fn main(IOStream io) void {", "    $0", "}"],
    "description": "Program entry point"
  },
  "fn": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2}) ${3:void} {", "    $0", "}"],
    "description": "Function"
  },
  "type struct": {
    "prefix": "struct",
    "body": ["type struct {", "    ${1:int} ${2:x};", "} ${3:Name};"],
    "description": "Struct"
  },
  "type interface": {
    "prefix": "interface",
    "body": ["type interface {", "    fn ${1:method}(Self self) ${2:int};", "} ${3:Name};"],
    "description": "Interface"
  },
  "impl": {
    "prefix": "impl",
    "body": ["impl {", "    fn ${1:method}(${2:Type} self) ${3:int} {", "        $0", "    }", "} ${2:Type};"],
    "description": "Impl block"
  },
  "space": {
    "prefix": "space",
    "body": ["space {", "    fn ${1:name}(${2}) ${3:int} {", "        $0", "    }", "} ${4:name};"],
    "description": "Space (self-impl)"
  },
  "library": {
    "prefix": "library",
    "body": ["library ${1:lib} {", "    fn ${2:sym}(${3}) ${4:void};", "}"],
    "description": "FFI library binding"
  },
  "for": {
    "prefix": "for",
    "body": ["for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i} = ${1:i} + 1) {", "    $0", "}"],
    "description": "C-style for"
  },
  "forin": {
    "prefix": "forin",
    "body": ["for (${1:int} ${2:x} : ${3:list}) {", "    $0", "}"],
    "description": "Iteration for"
  },
  "try": {
    "prefix": "try",
    "body": ["try {", "    $1", "} catch (void ${2:e}) {", "    $0", "}"],
    "description": "try/catch"
  },
  "macro": {
    "prefix": "macro",
    "body": ["macro ${1:name}(\\$a \\$b) {", "    #when (run) {", "        #return \\$a + \\$b", "    }", "}", "$0"],
    "description": "Named-parameter macro"
  }
}
