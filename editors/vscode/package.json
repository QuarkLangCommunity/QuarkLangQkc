{
  "name": "quarklang",
  "displayName": "QuarkLang",
  "description": "QuarkLang language support: syntax highlighting, diagnostics, go-to-definition and completion (built-in qklsp language server client, zero npm dependencies)",
  "version": "0.1.0",
  "publisher": "QuarkLangCommunity",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages", "Linters"],
  "keywords": ["quarklang", "qk", "lsp", "tree-sitter"],
  "repository": {
    "type": "git",
    "url": "https://github.com/QuarkLangCommunity/QuarkLangQkc"
  },
  "main": "./src/extension.js",
  "activationEvents": ["onLanguage:quarklang"],
  "contributes": {
    "languages": [
      {
        "id": "quarklang",
        "aliases": ["QuarkLang", "quarklang", "qk"],
        "extensions": [".qk", ".kq"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quarklang",
        "scopeName": "source.quarklang",
        "path": "./syntaxes/quarklang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "quarklang",
        "path": "./snippets/quarklang.json"
      }
    ],
    "configuration": {
      "title": "QuarkLang",
      "properties": {
        "quarklang.serverPath": {
          "type": "string",
          "default": "qklsp",
          "description": "Path to the qklsp executable (looked up on PATH by default; may also point at a build artifact such as ./cmd/qklsp/qklsp)"
        },
        "quarklang.libDirs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra import search directories (passed to qklsp -L; may be repeated)"
        },
        "quarklang.trace.server": {
          "type": "boolean",
          "default": false,
          "description": "Log qklsp request/response traffic to the output channel (for troubleshooting)"
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package"
  }
}
