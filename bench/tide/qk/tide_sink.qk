// Tide attribution, opaque sink only: the same loop arith and checksum as tide.qk, plus the opaque
// C sink call on a constant string, with no allocation and no release. Subtracting tide_empty from
// this row is the cost of the call into the C sink, not of the allocation it observes.
library tide {
    fn qtide_sink(String s) void;
}

fn main(IOStream io) {
    int rounds = 100000000;
    long acc = 0;
    int i = 0;
    String lit = "[]";
    int t0 = clock();
    while (i < rounds) {
        tide.qtide_sink(lit);
        acc = acc + (i % 7) + (i % 13);
        i = i + 1;
    }
    int t1 = clock();
    io.println(t1 - t0);
    io.println(acc);
}
