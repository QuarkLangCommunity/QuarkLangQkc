// Regression fixture: the compiler counts the same call depth as the interpreter (fixed).
//
//   quark    stress/repro/interpreter_recursion_limit.kq
//     error: StackOverflowError: recursion depth exceeded 8192 at line 13   (exit 1)
//   qkc -run stress/repro/interpreter_recursion_limit.kq
//     error: StackOverflowError: recursion depth exceeded 8192 at line 13   (exit 1)
//
// The two lines are byte-identical, stdout included. The interpreter caps recursion depth at 8192 (a
// deliberate DoS guard, see internal/lang/limits.go and attacksec_test.go) and the generated code counts
// the same levels with a thread-local counter, so a program that recurses deeper than the cap is refused
// by both engines at the same depth, at the same call site, with the same exit status. This used to be
// path_recursion_stack: the interpreter stopped at 8192 while the native binary printed 40504500 and
// exited 0.
fn down(int n) int {
  if (n == 0) { return 0; }
  return n + down(n - 1);
}

fn main(IOStream io) {
  io.println(down(9000));
}
