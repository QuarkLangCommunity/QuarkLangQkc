// Minimal reproduction: tail recursion, where the two engines differ even more sharply.
//
//   quark    stress/repro/interpreter_recursion_limit_tail.kq
//     error: StackOverflowError: recursion depth exceeded 8192 at line 12   (exit 1)
//   qkc -run stress/repro/interpreter_recursion_limit_tail.kq
//     9000                                                                (exit 0)
//
// The native backend turns the self call into a loop, so the depth never grows; the interpreter counts
// the calls and stops. Tracked as path_recursion_tail.
fn up(int n, int acc) int {
  if (n == 0) { return acc; }
  return up(n - 1, acc + 1);
}

fn main(IOStream io) {
  io.println(up(9000, 0));
}
