// Two kinds of "same name" that are deliberately NOT reported:
//   1) a local variable shadowing a **type name**: type annotations are parsed as type strings (`Point p` never does identifier lookup), so semantics cannot change;
//   2) a local variable shadowing a **space name**: space calls are always written `space::fn` (canonical S10) and cannot be hijacked by a local.
// Only shadowing a **global function** is reported (that would change what `f(...)` resolves to).
type struct { int v; } Point;
space {
    fn max(int a, int b) int { return a; }
} math;
fn main(IOStream io) void {
    Point Point = .{v: 1};
    int math = 2;
    io.println(Point.v + math + math::max(1, 2));
}
