// Realistic code: branches, loops, containers, strings, a default interface implementation (missing methods are only reported as a near-miss).
fn classify(int n) String {
    if (n < 0) {
        return "neg";
    } else if (n == 0) {
        return "zero";
    } else {
        return "pos";
    }
}
fn total(List<int> l) int {
    int sum = 0;
    for (int v : l) {
        sum = sum + v;
    }
    return sum;
}
fn main(IOStream io) void {
    List<int> l = [1, 2, 3];
    io.println(classify(total(l)));
    HashTable<String, int> h = HashTable::new();
    h.put("k", 1);
    io.println(h.contains("k"));
}
