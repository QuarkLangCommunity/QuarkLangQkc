// Deliberately not reported: an assignment inside a loop body is read on the next iteration (a linear scan cannot decide), so no dead-store judgement is made.
fn f(int n) int {
    int i = 0;
    while (i < n) {
        i = i + 1;
    }
    i = n - 1;
    return i;
}
fn main(IOStream io) void {
    io.println(f(3));
}
