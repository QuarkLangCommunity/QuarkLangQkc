// Deliberately not reported: the imported library is used **only in type annotations** (List<LibBox> / LibBox); a type string is not an Ident,
// so names must be collected from type annotations explicitly. This case contains no call to that library's methods, to isolate the behaviour.
program library;
import "helpertypes";

pub fn count(List<LibBox> boxes) int {
    return boxes.size();
}
