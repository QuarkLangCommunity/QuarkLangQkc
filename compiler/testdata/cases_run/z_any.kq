// z_any: interface{} (tAny) — boxing any value + runtime type information (RTTI descriptors)
// printing/equality/unboxing all dispatch on the runtime kind; semantic baseline = interpreter (byte-for-byte comparison via compare.sh).
// any_probe: interface{} (tAny) boxing + RTTI printing/equality/unboxing
type struct { int v; String s; } P;
type struct { int v; } P1;  // for printing (single field: the interpreter's field order is deterministic)
type struct { interface{} cell; int tag; } Box2;
fn id(interface{} x) interface{} { return x; }
fn setAny(interface{} x) void { x = "changed"; }
fn main(IOStream io) {
  interface{} a = 7;
  io.println(a);
  a = "str";
  io.println(a);
  a = 1.5;
  io.println(a);
  a = true;
  io.println(a);
  List<int> l = [1,2];
  a = l;
  io.println(a);
  P p; p.v = 3; p.s = "z";
  a = p;
  P1 p1; p1.v = 3;
  a = p1;
  io.println(a);
  // equality: int/float across types, String contents, struct references, nil
  interface{} x = 1;
  interface{} y = 1.0;
  io.println(x == y);
  interface{} s1 = "ab";
  interface{} s2 = "ab";
  io.println(s1 == s2);
  interface{} s3 = "cd";
  io.println(s1 == s3);
  interface{} p2 = p1;
  io.println(a == p2);
  P q; q.v = 3; q.s = "z";
  interface{} q2 = q;
  io.println(a == q2);
  // parameters/return
  interface{} c = id(9);
  io.println(c);
  io.println(c == 9);
  c = id("s2");
  io.println(c);
  // unboxing
  interface{} n1 = 42;
  int n = n1;
  io.println(n);
  interface{} f1 = 2.5;
  float ff = f1;
  io.println(ff);
  interface{} b1 = false;
  bool bb = b1;
  io.println(bb);
  interface{} st = "hello";
  String ss = st;
  io.println(ss);
  // interface{} field embedded in a struct
  Box2 bx; bx.cell = 5; bx.tag = 8;
  io.println(bx.cell);
  io.println(bx.tag);
  io.println(bx.cell == 5);
  // parameters by reference (interface{} is a two-word value)
  interface{} m = 1;
  setAny(m);
  io.println(m);
  interface{} nn = 0;
  io.println(nn);
}
