type struct { int v; String s; } P;
fn work(int n) int { return n; }
fn add2(int a, int b) int { return a + b; }
fn mix(int a, String s, float f, bool b) int {
    int r = a;
    if (b) { r = r + 1; }
    return r + s.size() + f.toString().size();
}
fn touch(P p, int d) int { p.v = p.v + d; return p.v; }

// merge 最多 8 个实参（qthreads 运行时 8 个 i64 槽）
fn sum8(int a, int b, int c, int d, int e, int f, int g, int h) int {
    return a + b + c + d + e + f + g + h;
}

fn main(IOStream io) {
    thread t = taskm.spawn();
    t.merge(work, 1);
    taskm.block(t.pid());
    io.println(taskm.done(t.pid()));
    thread t2 = taskm.spawn();
    t2.merge(add2, 3, 4);
    taskm.block(t2.pid());
    io.println(taskm.done(t2.pid()));
    thread t3 = taskm.spawn();
    taskm.merge(t3.pid(), mix, 5, "abc", 1.5, true);
    taskm.block(t3.pid());
    io.println(taskm.done(t3.pid()));
    P p; p.v = 10; p.s = "p";
    thread t4 = taskm.spawn();
    t4.merge(touch, p, 7);
    taskm.block(t4.pid());
    io.println(p.v);
    io.println(taskm.done(t4.pid()));
    thread t5 = taskm.spawn();
    t5.merge(sum8, 1, 2, 3, 4, 5, 6, 7, 8);
    taskm.block(t5.pid());
    io.println(taskm.done(t5.pid()));
    thread t6 = taskm.spawn();
    taskm.merge(t6.pid(), sum8, 10, 20, 30, 40, 50, 60, 70, 80);
    taskm.block(t6.pid());
    io.println(taskm.done(t6.pid()));
}
