// v_ptr_full: full T& / pointer T case (functions returning T&, struct pointers, nil printing for String&).
// Semantic baseline = interpreter (byte-for-byte comparison via compare.sh; this case uses the clang link path).
type struct { int v; } P;
fn setRef(int& p, int v) void { p = v; }
fn makeRef(int v) int& { int& p = new int; p = v; return p; }
fn main(IOStream io) {
    int& p = new int;
    p = 5;
    io.println(p == null, p != null);
    int& q;
    io.println(q == null);
    io.println(q);
    q = p;
    io.println(q);
    int& z = makeRef(42);
    io.println(z, z == 42);
    setRef(p, 9);
    io.println(p);
    String& s = new String;
    s = "hi";   // Note: the interpreter's new String cell is actually a List value (its implementation of
                // new for non-scalars is non-conformant), while the compiler treats it as the zero value of T
                // -> only the behaviour after the assignment is asserted here
    io.println(s, s == "hi");
    P& sp = new P;
    io.println(sp == null);
}
