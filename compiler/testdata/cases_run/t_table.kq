// t_table: HashTable<K,V> (put/get/contains/remove/size/keys).
// Keys are structured into a "TypeName:value" string following the interpreter's rules; values are boxed into interface{},
// and Put deep-copies by RTTI (List copies its buffer, struct shares the pointer, scalars/String are snapshotted).
// keys() follows Go map order in the interpreter (itself nondeterministic) -> the compiler sorts ascending by strcmp; this case only makes deterministic-order assertions.
type struct { int v; } P;
fn main(IOStream io) {
    HashTable<String, interface{}> a = HashTable::new();
    a.put("k", 5);
    a.put("s", "str");
    a.put("f", 1.5);
    a.put("b", true);
    io.println(a.get("k"));
    io.println(a.get("s"));
    io.println(a.get("f"));
    io.println(a.get("b"));
    io.println(a.get("missing"));            // missing key -> nil
    io.println(a.size(), a.contains("k"), a.contains("zz"));
    a.remove("k");
    io.println(a.size(), a.contains("k"));

    HashTable<String, int> t = HashTable::new();
    t.put("a", 1);
    t.put("b", 2);
    t.put("c", 3);
    io.println(t.get("a"), t.get("b"), t.get("c"));
    io.println(t.size(), t.contains("b"));
    t.remove("b");
    io.println(t.size(), t.contains("b"));
    t.put("b", 20);
    io.println(t.size(), t.get("b"));

    HashTable<int, String> n = HashTable::new();
    n.put(7, "seven");
    n.put(8, "eight");
    io.println(n.get(7), n.get(8), n.size());

    // keys() -> List<String>: the interpreter uses Go map order (may differ between runs) -> this case only makes **deterministic-order assertions**
    // (element count; the order of a single-key table is unique). The compiler side always sorts ascending by strcmp (see the report).
    io.println(t.keys().size());
    HashTable<String, int> solo = HashTable::new();
    solo.put("only", 1);
    List<String> sk = solo.keys();
    io.println(sk.size(), sk.toString(), sk.get(0));
    int cnt = 0;
    for (String k : sk) { cnt = cnt + 1; }
    io.println(cnt);

    // value semantics: a List value is deep-copied on Put (mutating the original list does not affect the snapshot in the table)
    HashTable<String, List<int>> tl = HashTable::new();
    List<int> l = [1, 2];
    tl.put("k", l);
    l.append(3);
    List<int> got = tl.get("k");
    io.println(got.toString(), l.toString());

    // struct value: the interpreter's deepCopy does not copy structs -> the table holds the same object
    HashTable<String, P> tp = HashTable::new();
    P p; p.v = 1;
    tp.put("k", p);
    p.v = 2;
    P q = tp.get("k");
    io.println(q.v);

    // multiple tables do not affect each other
    HashTable<String, int> t2 = HashTable::new();
    t2.put("a", 100);
    io.println(t.get("a"), t2.get("a"));
}
