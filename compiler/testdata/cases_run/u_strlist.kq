// u_strlist: String.split -> List<String> (same Go strings.Split semantics as the interpreter) + read-only subset.
// List<String> operations lowered by the compiler: size()/get(i)/toString()/for-in/index reads/io.println.
fn main(IOStream io) {
    String csv = "a,b,,c";
    List<String> l = csv.split(",");
    io.println(l.size());
    io.println(l.toString());
    io.println(l.get(0), l.get(2), l.get(3));
    io.println(l[1]);
    io.println("".split(",").size());
    io.println("".split(",").get(0) == "");
    List<String> r = "abc".split("");
    io.println(r.size(), r.toString());
    List<String> w = "one two three".split(" ");
    io.println(w.size());
    io.println(w.get(1));
    io.println(w.get(0) + "|" + w.get(2));
    // for-in consumes via a rolling cursor (interpreter semantics: after the loop the head has advanced and size is zero) -> placed last
    List<String> w2 = "one two three".split(" ");
    int n = 0;
    for (String s : w2) { n = n + s.size(); }
    io.println(n, w2.size());
}
