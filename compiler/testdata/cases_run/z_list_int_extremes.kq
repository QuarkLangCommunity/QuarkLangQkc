// List<int>.toString must spell every int32 the way the interpreter does: no leading zeros, a '-'
// only on negatives, and the minimum integer without a negation overflow. The renderer formats in
// place now; this case keeps that formatting honest at the extremes.
fn main(IOStream io) {
    List<int> l = [0, -1, 1, 42, -42, 2147483647, -2147483647 - 1];
    io.println(l.toString());
    List<int> e = [];
    io.println(e.toString());
    List<int> one = [-2147483647 - 1];
    io.println(one.toString());
}
