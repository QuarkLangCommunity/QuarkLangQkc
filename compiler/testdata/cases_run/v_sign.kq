// v_sign: signature call f(args) @sign(prefix) (canonical §6) — built-in memorize memoization.
// Semantic baseline = interpreter: the first call runs the wrapped function and records the result; later calls with the same key return the cached value.
// Note: the signature mechanism records the in list by value (the interpreter's derefArgs), so writes to the wrapped function's parameters do not write back to the caller.
fn square(int n) int {
    return n * n;
}

fn add2(int a, int b) int {
    return a + b;
}

fn mix(int a, String s, int b) int {
    return a + s.size() + b;
}

fn boom(int n) int {
    return n + 1;
}

fn main(IOStream io) {
    memorize mb = memorize::new();
    io.println(square(41) @mb());      // 1681
    io.println(square(41) @mb());      // 1681 (cached)
    io.println(square(42) @mb());      // 1764
    io.println(square(41) @mb());      // 1681 (cached)
    // @ explicit prefix arguments: the interpreter evaluates them and stores them in the prefix record (memorize does not use them)
    int x = 7;
    io.println(square(3) @mb(x));      // 9
    io.println(square(3) @mb(x + 1));  // 9 (same key)
    io.println(x);                     // 7
    // multiple int arguments: the key is the whole argument list
    memorize m2 = memorize::new();
    io.println(add2(1, 2) @m2());      // 3
    io.println(add2(1, 2) @m2());      // 3
    io.println(add2(2, 1) @m2());      // 3 (different key -> re-executed, same result)
    // separate instances do not share their cache
    io.println(add2(1, 2) @mb());      // 3 (mb has not recorded add2 -> executes)
    io.println(add2(1, 2) @m2());      // 3 (already recorded by m2)
    // expression position (arithmetic/concatenation)
    io.println((square(5) @mb()) + (square(5) @mb()));  // 50
    io.println("v=" + (square(6) @mb()).toString());    // v=36
    // the wrapped function may be overloaded / called from other functions
    io.println(boom(1) @mb());         // 2
    int q = square(9) @mb();
    io.println(q);                     // 81
}
