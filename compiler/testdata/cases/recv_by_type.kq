// recv_by_type: receiver detection is **by type** (first param type == Self, or its base name
// equals the impl/interface type, ignoring <...> and & suffixes) and is independent of the
// parameter name; a first param with no type annotation is completed as the receiver
// (the current parser does not accept fully untyped params, so that branch only takes effect
// on the type-annotation-defaulting path).
// Semantic baseline = interpreter (/tmp/quark and /tmp/qkc -run byte-for-byte identical).
type struct { int a; int b; } P;
impl {
    fn new(int a, int b) P { P p; p.a = a; p.b = b; return p; }   // static method (first param is not a receiver)
    fn sum(P me) int { return me.a + me.b; }                      // instance: the type is the impl type, the name is not self
    fn sum2(Self other) int { return other.a * other.b; }         // instance: Self
    fn twice(int self) int { return self * 2; }                   // static: named self but the type is not P
} P;
type interface { fn sum(Self s) int; } C;                         // interface receiver is written Self, name arbitrary

type struct<T> { T v; } Box;
impl<T> {
    fn get(Box<T> b) T { return b.v; }                            // instance: generic base name Box<T> -> Box
    fn set(Box<T> me, T d) T { me.v = d; return me.v; }           // instance: arbitrary name + params by reference
} Box;

fn main(IOStream io) {
    P p = P::new(3, 4);
    io.println(p.sum());     // 7
    io.println(p.sum2());    // 12
    C c = p;
    io.println(c.sum());     // 7 (interface vtable dispatches to the same instance method)
    io.println(P::twice(21)); // 42 (static: the name self does not make it a receiver)
    Box<int> b; b.v = 9;
    io.println(b.get());     // 9
    int d = 5;
    io.println(b.set(d));    // 5 (params by reference: d is still 5)
    io.println(b.v);         // 5
    io.println(d);           // 5
}
