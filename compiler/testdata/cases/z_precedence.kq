// Precedence, loosest first (spec §5): ||, &&, == != < <= > >=, |, ^, &, << >>, + -, * / %, then the unary
// operators. Every line pins one level against the standard's stated order rather than against the other
// engine, because the parity gate alone cannot see a precedence disagreement — both engines can hold the
// same wrong order (docs/primitives.md §1.3, §7.3).
//
// The shift level used to be the one place where both engines disagreed with §5: the standard puts `<< >>`
// looser than `+ -`, so `1 + 2 << 3` reads `(1 + 2) << 3` = 24, while the pinned syntax layer grouped it as
// `1 + (2 << 3)` = 17. §11.3 recorded that divergence and the fix that closes it; the syntax layer carries
// the fix since then, so the three shift lines below print §5's values (24, 32, 4) in both engines, and a
// failure here means the grouping moved back.
fn main(IOStream io) {
    io.println(true || false && false);   // && is looser than ||: true
    io.println(1 | 2 == 3);               // the bitwise family is tighter than comparison: (1|2) == 3
    io.println(1 | 2 ^ 3);                // ^ is tighter than |: 1 | (2^3) = 1
    io.println(4 ^ 1 & 1);                // & is tighter than ^: 4 ^ (1&1) = 5
    io.println(3 & 1 << 2);               // << is tighter than &: 3 & (1<<2) = 0
    io.println(1 + 2 << 3);               // §11.3 closed: (1 + 2) << 3 = 24
    io.println(1 << 2 + 3);               // §11.3 closed: 1 << (2 + 3) = 32
    io.println(10 - 2 >> 1);              // §11.3 closed: (10 - 2) >> 1 = 4
    io.println(1 + (2 << 3));             // explicit grouping: 17 under every reading
    io.println((1 + 2) << 3);             // explicit grouping: 24 under every reading
    io.println(1 + 2 * 3);                // * is tighter than +: 7
    io.println(2 * 3 % 4);                // one level, left to right: 2
    io.println(1 - 2 - 3);                // one level, left to right: -4
    io.println(-1 + 2);                   // unary - binds tightest: 1
    io.println(~0 + 1);                   // unary ~ binds tightest: 0
}
