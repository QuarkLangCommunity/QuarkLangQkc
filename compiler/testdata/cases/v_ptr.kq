// v_ptr: nullable T& / pointer T references (interpreter semantics: automatic dereference on read/write,
// == null compares pointer identity, and comparison against a value uses the dereferenced value,
// yielding false when nil following the interpreter's equalValues semantics).
// Note: the full case is cases_run/v_ptr_full.kq (lli suffers a JIT crash for one combination, so it is verified via the clang path).
fn setRef(int& p, int v) void { p = v; }
fn main(IOStream io) {
    int& p = new int;
    p = 5;
    io.println(p);
    io.println(p == null, p != null);
    int& q;
    io.println(q == null);
    q = p;
    q = 7;
    io.println(p, q);
    io.println(p == 5, p != 5);
    setRef(p, 9);
    io.println(p);
    pointer int r = new int;
    r = 3;
    io.println(r);
    float& f = new float;
    f = 1.5;
    io.println(f);
    bool& b = new bool;
    b = true;
    io.println(b);
    String& s = new String;
    s = "hi";
    io.println(s, s == "hi");
}
