// y_edge: edge-case semantics (generic function as a sum generator, tail calls, List literal assignment/arguments, function overloading).
fn<T> ident(T x) T { return x; }
fn add(int a, int b) int { return a + b; }
fn add(String a, String b) String { return a + "<" + b; }
fn add(int a, int b, int c) int { return a + b + c; }
fn tailSum(int n, int acc) int { if (n == 0) { return acc; } return tailSum(n - 1, acc + n); }
fn<T> bump(T x) T { x = x; return x; }
fn sumList(List<int> l) int { int t = 0; for (int x : l) { t = t + x; } return t; }
type struct { int v; } V;
impl { fn __add__(V self, V o) V { V z; z.v = self.v + o.v; o = z; return z; } } V;
type struct<T> { T v; } Box;
impl<T> { fn get(Box<T> self) T { return self.v; } } Box;

fn main(IOStream io) {
  io.println(sum(ident, 1, 5));        // 10 (the generic generator is monomorphized with T=int)
  io.println(sum(ident, 1, 6, 2));     // 9
  io.println(tailSum(5, 0));           // 15 (tail call: the argument is a parameter slot -> stable address)
  io.println(tailSum(1000, 0));        // 500500
  List<int> l = [1, 2, 3];
  l = [4, 5];                          // list literal assignment
  io.println(sumList(l));              // 9
  io.println(sumList([6, 7]));         // 13 (list literal as an argument)
  io.println(add(1, 2));               // 3
  io.println(add("a", "b"));           // a<b
  io.println(add(1, 2, 3));            // 6
  io.println(add(add(1, 2), 4));       // 7
  // operator-overload arguments are by value (the interpreter evaluates BinOp -> not a reference): rebinding an operand does not write back
  V a; a.v = 1;
  V b; b.v = 2;
  V c = a + b;
  io.println(c.v);                     // 3
  io.println(b.v);                     // 2
  // generic function parameters are by reference too (T monomorphized to int)
  int n = 5;
  io.println(bump(n));                 // 5
  io.println(n);                       // 5
  Box<int> bx; bx.v = 9;
  io.println(bx.get());                // 9
}
